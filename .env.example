# Keep demo for the local, browser-only experience. Use remote only after applying
# the migrations/seed to a development Supabase project.
VITE_DATA_MODE=demo
# Required only when VITE_DATA_MODE=remote. Publishable browser key only;
# never put service_role or Judge0 secrets in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Where the "Executar código" button sends code. Empty: /api/judge/submit in `npm run dev`,
# the judge-submit Edge Function in remote mode, and no judge in static builds (button
# disabled). Use "off" to disable explicitly. See docs/JUDGE-API.md.
VITE_JUDGE_URL=
# Server-side Judge0 configuration (local dev server and `supabase secrets set` for the
# Edge Function); never prefix secrets with VITE_.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_AUTH_TOKEN=
