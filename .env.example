# Keep demo for the local, browser-only experience. Use remote only after applying
# the migrations/seed to a development Supabase project.
VITE_DATA_MODE=demo
# Required only when VITE_DATA_MODE=remote. Publishable browser key only;
# never put service_role or Judge0 secrets in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
